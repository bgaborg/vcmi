#!/usr/bin/env bash
# Pre-commit checks of the Quest fork, fast and local (quest/PHASE2.md, "Working on the headset"):
# - the staged Quest files linted by type (quest/tools/lint.sh: gdlint, clang-format, shellcheck, PMD, ruff)
# - staged changes under quest/xr/: the host's headless tests (quest/tools/test-local.sh, about 7 s)
# Installed by quest/tools/install-hooks.sh into .git/hooks, next to the Git LFS hooks. Skip once: git commit --no-verify.
# shortcut: it checks the working tree's version of each staged file, not the staged one (no stash); stage whole files

set -eo pipefail

REPO="$(git rev-parse --show-toplevel)"
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR -- quest android/vcmi-app/src/quest)
[ ${#STAGED[@]} -gt 0 ] || exit 0

"$REPO/quest/tools/lint.sh" "${STAGED[@]}" || { echo "pre-commit: lint failed (skip once with --no-verify)" >&2; exit 1; }

if printf '%s\n' "${STAGED[@]}" | grep -q '^quest/xr/'; then
	GODOT="${GODOT_WIN:-$HOME/vcmi-tools/godot-4.7.2-win}/Godot_v4.7.2-stable_win64_console.exe"
	if [ ! -x "$GODOT" ]; then
		echo "pre-commit: Godot not found ($GODOT): the host's local tests did not run" >&2
		exit 0
	fi
	echo "pre-commit: quest/xr changed, running quest/tools/test-local.sh"
	"$REPO/quest/tools/test-local.sh" || { echo "pre-commit: local tests failed (skip once with --no-verify)" >&2; exit 1; }
fi
