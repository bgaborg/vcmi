<?xml version="1.0" encoding="utf-8"?>
<!-- Horizon OS additions for the Meta Quest build, merged over ../../../AndroidManifest.xml by quest.gradle -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:metavr="http://schemas.meta.com/metavr-sdk">

	<!-- required for hybrid apps: https://developers.meta.com/horizon/documentation/spatial-sdk/hybrid-apps-overview -->
	<metavr:uses-metavr-sdk
		metavr:minSdkVersion="69"
		metavr:targetSdkVersion="207" />

	<!-- as in other hybrid apps (Steam Link VR); the OpenXR vendor AAR declares it optional -->
	<uses-feature
		android:name="android.hardware.vr.headtracking"
		android:required="true"
		android:version="1"
		tools:replace="android:required" />
	<uses-feature
		android:name="oculus.software.vr.app.hybrid"
		android:required="true" />

	<!-- controller models (XR_FB_render_model) -->
	<uses-feature
		android:name="com.oculus.feature.RENDER_MODEL"
		android:required="false" />
	<uses-permission android:name="com.oculus.permission.RENDER_MODEL" />

	<!-- the room behind the screen (XR_FB_passthrough), switched on by holding the left menu button -->
	<uses-feature
		android:name="com.oculus.feature.PASSTHROUGH"
		android:required="false" />

	<application>
		<meta-data
			android:name="com.oculus.supportedDevices"
			android:value="quest3|quest3s"
			tools:replace="android:value" />

		<!-- the Godot library declares the same FileProvider for its own file sharing, which the XR host does not use -->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths"
				tools:replace="android:resource" />
		</provider>

		<!-- Initial panel size; the user can resize the panel. The minimum is the H3 resolution, 800x600 -->

		<activity android:name="eu.vcmi.vcmi.ActivityLauncher">
			<layout
				android:defaultWidth="1280dp"
				android:defaultHeight="720dp"
				android:minWidth="800dp"
				android:minHeight="600dp" />

			<!-- hybrid app: the launcher stays a panel, the game runs immersive -->
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="com.oculus.intent.category.2D" />
			</intent-filter>
		</activity>

		<activity android:name="eu.vcmi.vcmi.ActivityMapEditor">
			<layout
				android:defaultWidth="1280dp"
				android:defaultHeight="720dp"
				android:minWidth="800dp"
				android:minHeight="600dp" />
		</activity>

		<!-- VcmiXrActivity starts it on its own virtual display (allowEmbedded); without the immersive activity it runs as a panel -->
		<activity
			android:name="eu.vcmi.vcmi.VcmiSDLActivity"
			android:allowEmbedded="true">
			<layout
				android:defaultWidth="1280dp"
				android:defaultHeight="720dp"
				android:minWidth="800dp"
				android:minHeight="600dp" />
		</activity>

		<!-- The Godot XR host (quest/xr); ActivityLauncher starts it when it exists, quest/tools/quest.sh start-xr without the launcher.
			 Not resizeable, landscape, no layout: Horizon runs an activity with a layout or an activity-alias as a panel -->
		<activity
			android:name="eu.vcmi.vcmi.VcmiXrActivity"
			android:exported="true"
			android:taskAffinity="${applicationId}.xr"
			android:launchMode="singleTask"
			android:resizeableActivity="false"
			android:screenOrientation="landscape"
			android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
			android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="com.oculus.intent.category.VR" />
				<category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
			</intent-filter>
			<!-- keeps the session running, unfocused, while the system menu is open -->
			<meta-data
				android:name="com.oculus.vr.focusaware"
				android:value="true" />
		</activity>
	</application>

</manifest>
